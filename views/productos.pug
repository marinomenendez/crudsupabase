html 
    head
        title=title 
    body 
        h1="Listado de productos"
        a(href='/nuevo') Nuevo producto
        table(border="1")
            tr
                th Nombre
                th Unidades
                th Precio
            each producto in productos.data
                tr 
                    td=producto.nombre
                    td=producto.unidades
                    td=producto.precio
